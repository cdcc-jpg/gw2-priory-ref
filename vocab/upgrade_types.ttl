@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory-ref: <https://priory.gw2/ref/> .
@prefix upgrade: <https://priory.gw2/ref/upgrade/> .

priory-ref:UpgradeTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "Guild Wars 2 Upgrade Component Scheme"@en ;
    rdfs:comment "Controlled vocabulary of equipment upgrade components in Guild Wars 2 (Sigils, Runes, Relics, Infusions, Enrichments)."@en ;
    skos:hasTopConcept upgrade:Sigil, upgrade:Rune, upgrade:Relic, upgrade:Infusion, upgrade:Enrichment .

upgrade:Sigil a skos:Concept ;
    skos:inScheme priory-ref:UpgradeTypeScheme ;
    skos:topConceptOf priory-ref:UpgradeTypeScheme ;
    skos:prefLabel "Sigil"@en ;
    skos:altLabel "Weapon Sigil"@en, "Sigils"@en ;
    skos:definition "Weapon upgrade component granting passive or on-trigger combat effects."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Sigil> .

upgrade:Rune a skos:Concept ;
    skos:inScheme priory-ref:UpgradeTypeScheme ;
    skos:topConceptOf priory-ref:UpgradeTypeScheme ;
    skos:prefLabel "Rune"@en ;
    skos:altLabel "Armor Rune"@en, "Runes"@en ;
    skos:definition "Armor upgrade component granting set stat bonuses."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Rune> .

upgrade:Relic a skos:Concept ;
    skos:inScheme priory-ref:UpgradeTypeScheme ;
    skos:topConceptOf priory-ref:UpgradeTypeScheme ;
    skos:prefLabel "Relic"@en ;
    skos:altLabel "Combat Relic"@en, "Relics"@en, "Legendary Relic"@en ;
    skos:definition "Equipment slot upgrade granting unique build-defining combat triggers, introduced in Secrets of the Obscure."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Relic> .

upgrade:Infusion a skos:Concept ;
    skos:inScheme priory-ref:UpgradeTypeScheme ;
    skos:topConceptOf priory-ref:UpgradeTypeScheme ;
    skos:prefLabel "Infusion"@en ;
    skos:altLabel "Agony Infusion"@en, "Stat Infusion"@en ;
    skos:definition "Agony resistance and stat infusion slotted into Ascended and Legendary equipment."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Infusion> .

upgrade:Enrichment a skos:Concept ;
    skos:inScheme priory-ref:UpgradeTypeScheme ;
    skos:topConceptOf priory-ref:UpgradeTypeScheme ;
    skos:prefLabel "Enrichment"@en ;
    skos:altLabel "Amulet Enrichment"@en ;
    skos:definition "Utility enrichment slotted into Ascended and Legendary amulets (Karma bonus, Magic Find, XP)."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Enrichment> .
